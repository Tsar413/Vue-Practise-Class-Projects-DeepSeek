# Deliberately excludes request URI/query/auth: practice URLs contain access codes.
log_format vue_practice_safe '$time_iso8601 $request_method $status $body_bytes_sent $request_time';
server {
    listen 80;
    server_name 106.14.114.66;
    root /opt/vue-practice/current/frontend;
    index index.html;
    server_tokens off;
    client_max_body_size 6m;
    access_log /var/log/nginx/vue-practice.access.log vue_practice_safe;
    error_log /var/log/nginx/vue-practice.error.log crit;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    location ~ ^/(api(?:/|$)|login$|logout$|hello$) {
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 95s;
        proxy_send_timeout 95s;
        proxy_hide_header X-Powered-By;
    }
    location ~ /\. { deny all; }
    location /assets/ { try_files $uri =404; expires 7d; }
    location / { try_files $uri $uri/ /index.html; }
}
